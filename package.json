{
	"name": "n8n-nodes-nexis",
	"version": "1.0.0",
	"description": "Find and remove personal data (PII) from text in n8n – redact, mask or encrypt emails, names, NHS and SSN numbers. GDPR, UK GDPR, HIPAA. Powered by Intelation Nexis.",
	"license": "MIT",
	"homepage": "https://www.intelation.com/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"nexis",
		"intelation",
		"privacy",
		"anonymization",
		"redact",
		"dlp",
		"sanitize",
		"nhs",
		"ssn",
		"personal-data",
		"pii",
		"gdpr",
		"hipaa"
	],
	"author": {
		"name": "Intelation",
		"email": "engineering@intelation.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/intelation-labs/n8n-nodes-nexis.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"dev:n8n": "n8n-node dev --external-n8n",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.test.json && node --test \".test-build/test/**/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/NexisApi.credentials.js",
			"dist/credentials/NexisEncryptionApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Nexis/Nexis.node.js"
		]
	},
	"devDependencies": {
		"@eslint/js": "^9.29.0",
		"@n8n/node-cli": "^0.52.1",
		"@types/node": "^26.6.5",
		"eslint": "9.29.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.9.10",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
